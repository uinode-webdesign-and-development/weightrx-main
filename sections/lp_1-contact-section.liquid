<div id="contact" data-section-id="{{ section.id }}" class="s-contact-section">
  <div class="section-spacing">
    <div class="container">
      <div class="s-contact-layout">
        <div class="s-contact-left">
          {% if section.settings.tagline != blank %}
            <div class="s-contact-tag">{{ section.settings.tagline }}</div>
          {% endif %}

          <h2 class="s-contact-title">{{ section.settings.title }}</h2>
          <p class="s-contact-text">{{ section.settings.text }}</p>

          <div class="s-contact-item-wrap">
            {% if section.settings.email_link != blank %}
              <div class="s-contact-item">
                {% if section.settings.email_icon != blank %}
                  <img
                    loading="lazy"
                    src="{{ section.settings.email_icon | image_url: width: 24 }}"
                    alt=""
                    class="s-contact-item-icon"
                    width="100%"
                    height="auto"
                  >
                {% endif %}
                <a href="mailto:{{ section.settings.email_link }}" class="s-contact-item-text">
                  {{- section.settings.email_link -}}
                </a>
              </div>
            {% endif %}

            {% if section.settings.phone_link != blank %}
              <div class="s-contact-item">
                {% if section.settings.phone_icon != blank %}
                  <img
                    loading="lazy"
                    src="{{ section.settings.phone_icon | image_url: width: 24 }}"
                    alt=""
                    class="s-contact-item-icon"
                    width="100%"
                    height="auto"
                  >
                {% endif %}
                <a href="tel:{{ section.settings.phone_link | replace: ' ', '' }}" class="s-contact-item-text">
                  {{- section.settings.phone_link -}}
                </a>
              </div>
            {% endif %}
          </div>

          <div class="s-contact-info">{{ section.settings.form_instruction }}</div>
        </div>

        <div id="s-contact-right" class="s-contact-right">
          <div class="s-contact-us-wrap w-form">
            {% comment %}
              Plain form (not Shopify's {% form 'contact' %}). Submission is handled
              entirely by the JS below, which POSTs JSON to the WeightRx admin API.
              Using a Shopify contact form caused a SECOND, native POST to /contact
              (triggered by Shopify's captcha script calling form.submit()), which
              reloaded the page with an "Email is invalid." error on top of the
              successful submission. A plain form with no action and no form_type
              input is ignored by that captcha script, so only our submission runs.
            {% endcomment %}
            {%- comment -%}
              `required` on name/phone/email/message mirrors what the API enforces on
              the public scope (first_name, last_name, email, phone, message). No
              `novalidate` — the browser blocks the submit for free, no JS needed.
            {%- endcomment -%}
            <form class="s-contact-us">
              <div class="s-contact-us-grid">
                <div class="s-contact-us-input-wrap">
                  <input
                    class="s-contact-us-input w-input"
                    name="contact[name]"
                    placeholder="Full name"
                    type="text"
                    id="ContactFormName-{{ section.id }}"
                    value="{% if customer %}{{ customer.name }}{% endif %}"
                    required
                    pattern="\s*\S+\s+\S.*"
                    title="Please enter your first and last name."
                  >
                </div>
                <div class="s-contact-us-input-wrap">
                  <input
                    class="s-contact-us-input w-input"
                    name="contact[phone]"
                    placeholder="Contact Number"
                    type="tel"
                    id="ContactFormPhone-{{ section.id }}"
                    value="{% if customer %}{{ customer.phone }}{% endif %}"
                    required
                  >
                </div>
              </div>

              <div class="s-contact-us-input-wrap">
                <input
                  class="s-contact-us-input w-input"
                  name="contact[email]"
                  placeholder="Email"
                  type="email"
                  id="ContactFormEmail-{{ section.id }}"
                  value="{% if customer %}{{ customer.email }}{% endif %}"
                  spellcheck="false"
                  autocapitalize="off"
                  required
                >
              </div>

              <div class="s-contact-us-textarea-wrap">
                <textarea
                  id="ContactFormMessage-{{ section.id }}"
                  name="contact[body]"
                  placeholder="Message"
                  class="s-contact-us-textarea w-input"
                  required
                ></textarea>
              </div>

              {%- comment -%}
                The API key below is the PUBLIC scope (support:contact:write), so the
                server requires and verifies turnstile_token on every submit. Turnstile
                injects a hidden <input name="cf-turnstile-response"> into this form;
                the JS reads it from there.
              {%- endcomment -%}
              <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
              <div
                class="cf-turnstile"
                data-sitekey="0x4AAAAAADCmgfcAXo3Wcjdw"
                data-theme="light"
              ></div>

              <div class="s-contact-us-btn-wrap">
                <input type="submit" class="s-contact-us-btn w-button" value="{{ section.settings.button_text }}">
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.querySelector('.s-contact-us');

    if (!form) {
      console.error('Form not found');
      return;
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      // Server rejects a missing/invalid token with 422, so bail early with a
      // clearer message than "Security check failed".
      const turnstileToken = form.querySelector('[name="cf-turnstile-response"]')?.value || '';
      if (!turnstileToken) {
        alert('Please complete the security check before submitting.');
        return;
      }

      const submitBtn = form.querySelector('[type="submit"]');
      const originalBtnValue = submitBtn ? submitBtn.value : null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.value = 'Sending...';
      }

      // The API wants first_name/last_name; the form collects one "Full name".
      // Split on the first space: "Ana Maria Perez" -> "Ana" / "Maria Perez".
      const fullName = form.querySelector('[name="contact[name]"]').value.trim();
      const spaceAt = fullName.indexOf(' ');

      // NOTE: Content-Type: application/json + Authorization make this a
      // NON-simple CORS request, so the browser fires a preflight OPTIONS first.
      // The route already allowlists https://weightrx.com and https://www.weightrx.com
      // and answers OPTIONS with the right Allow-Headers — see
      // internaldashboard/src/app/api/support-contact/route.ts. If this form is ever
      // rendered on another domain, that allowlist has to be updated too.
      try {
        const response = await fetch('https://admin.weightrx.com/api/support-contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: 'Bearer weightrx_d41a4a3fcfc1e403730ed2fcbf7af7132e9ee09344852b0c12e9ee9a7baf4f40',
          },
          body: JSON.stringify({
            first_name: spaceAt === -1 ? fullName : fullName.slice(0, spaceAt),
            last_name: spaceAt === -1 ? '' : fullName.slice(spaceAt + 1).trim(),
            email: form.querySelector('[name="contact[email]"]').value,
            phone: form.querySelector('[name="contact[phone]"]').value,
            message: form.querySelector('[name="contact[body]"]').value,
            turnstile_token: turnstileToken,
          }),
        });

        if (response.ok) {
          alert('Thank you! Your message has been sent.');
          form.reset();
        } else {
          // The API returns { error: "..." } — show it rather than a generic message.
          const data = await response.json().catch(function () {
            return {};
          });
          alert(data.error || 'Something went wrong. Please try again.');
        }
      } catch (error) {
        console.error('Contact API Error:', error);
        alert('Error submitting form. Please try again.');
      } finally {
        // A Turnstile token is single-use, so reset the widget after every attempt.
        if (window.turnstile) window.turnstile.reset();
        if (submitBtn) {
          submitBtn.disabled = false;
          if (originalBtnValue !== null) submitBtn.value = originalBtnValue;
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "LP Contact Section",
  "class": "lp_1_contact_section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Contact Us"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Questions? We're Here and Happy To Help."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "No Question Is Too Small. Our team is here to answer your questions and find the best path forward for you."
    },
    {
      "type": "image_picker",
      "id": "email_icon",
      "label": "Email Icon"
    },
    {
      "type": "text",
      "id": "email_link",
      "label": "Email Address",
      "default": "support@weightrx.com"
    },
    {
      "type": "image_picker",
      "id": "phone_icon",
      "label": "Phone Icon"
    },
    {
      "type": "text",
      "id": "phone_link",
      "label": "Phone Number",
      "default": "+1 (866) 286 4886"
    },
    {
      "type": "text",
      "id": "form_instruction",
      "label": "Form Instruction",
      "default": "Or fill out the form and our team will respond as soon as possible:"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Send Message"
    }
  ],
  "presets": [
    {
      "name": "LP Contact Section"
    }
  ]
}
{% endschema %}
