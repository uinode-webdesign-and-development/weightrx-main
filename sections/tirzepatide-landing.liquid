{%- style -%}
  @font-face {
    font-family: "SF Pro Display"; font-weight: 400; font-style: normal; font-display: swap;
    src: url("{{ 'SFProDisplay-Regular.otf' | asset_url }}") format("opentype");
  }
  @font-face {
    font-family: "SF Pro Display"; font-weight: 500; font-style: normal; font-display: swap;
    src: url("{{ 'SFProDisplay-Medium.otf' | asset_url }}") format("opentype");
  }
  @font-face {
    font-family: "SF Pro Display"; font-weight: 700; font-style: normal; font-display: swap;
    src: url("{{ 'SFProDisplay-Bold.otf' | asset_url }}") format("opentype");
  }

  .wrx-lp {
    /* ---- design-system tokens (scoped so the page is theme-independent) ---- */
    --color-bg: #f9f9f9;
    --wrx-blue-50: #eaf2ff;
    --brand-primary: #006bff;
    --brand-primary-ink: #ffffff;
    --wrx-navy-900: #162036;
    --wrx-navy-950: #031f46;
    --wrx-ink: #2f2f2f;
    --wrx-black: #000000;
    --wrx-line: rgba(0,0,0,0.15);
    --text-heading: #2f2f2f;
    --text-body: rgba(0,0,0,0.80);
    --text-subtle: rgba(0,0,0,0.60);
    --success: #6fcc58;
    --success-star: #00b67a;
    --font-body: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --font-heading: "SF Pro Display", -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif;
    --font-serif: "Instrument Serif", ui-serif, Georgia, "Times New Roman", serif;
    --font-script: "Road Rage", "Brush Script MT", cursive;
    --font-label: "Geist", "Inter", -apple-system, sans-serif;
    --radius-pill: 999px;
    --shadow-card: 0 1px 2px rgba(16,24,40,0.04), 0 1px 3px rgba(16,24,40,0.06);
    --shadow-cta: 0 6px 16px rgba(0,107,255,0.28);
    --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);

    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    color: var(--text-body);
    color-scheme: light;
  }
  .wrx-lp *, .wrx-lp *::before, .wrx-lp *::after { box-sizing: border-box; }
  .wrx-lp a { color: inherit; }

  /* ════════ shared components (both layouts) ════════ */
  .wrx-lp .btn {
    display: inline-flex; width: 100%; box-sizing: border-box; height: 55px; padding: 0 16px;
    gap: 8px; align-items: center; justify-content: center; border: none; border-radius: var(--radius-pill);
    background: var(--brand-primary); color: var(--brand-primary-ink); box-shadow: var(--shadow-cta);
    font-family: var(--font-body); font-weight: 500; font-size: 16px; letter-spacing: -0.01em;
    line-height: 1; cursor: pointer; text-decoration: none;
    transition: transform 120ms var(--ease-standard), filter 120ms var(--ease-standard);
  }
  .wrx-lp .btn:active { transform: scale(0.98); }
  .wrx-lp .btn > span { white-space: nowrap; }
  .wrx-lp .btn--sm { height: 38px; padding: 0 12px; font-size: 14px; width: auto; }
  .wrx-lp .btn--sm svg { width: 15px; height: 15px; }

  .wrx-lp .cta-shine { position: relative !important; overflow: hidden !important; }
  .wrx-lp .cta-shine::after {
    content: ""; position: absolute; top: 0; bottom: 0; left: -150%; width: 55%;
    background: linear-gradient(100deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.55) 50%, rgba(255,255,255,0) 100%);
    transform: skewX(-18deg); pointer-events: none;
    animation: wrxCtaSweep 4s cubic-bezier(.4,0,.2,1) infinite;
  }
  @keyframes wrxCtaSweep { 0% { left: -150%; } 60% { left: 175%; } 100% { left: 175%; } }

  .wrx-lp .chip {
    display: inline-flex; align-items: center; gap: 6px; padding: 6px 8px; border-radius: var(--radius-pill);
    background: var(--color-bg); box-shadow: inset 0 0 0 1px var(--wrx-line);
    font-family: var(--font-body); font-size: 12px; letter-spacing: -0.01em; color: var(--wrx-black);
    line-height: 1; white-space: nowrap;
  }
  .wrx-lp .stars { display: inline-flex; gap: 1.5px; }
  .wrx-lp .star { flex-shrink: 0; background: var(--success-star); display: inline-flex; align-items: center; justify-content: center; }
  .wrx-lp .badge-brand {
    display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: var(--radius-pill);
    background: var(--brand-primary); color: #fff; font-family: var(--font-body); font-weight: 500;
    font-size: 12px; letter-spacing: -0.01em; line-height: 1; white-space: nowrap;
  }
  .wrx-lp .stat { display: inline-flex; align-items: flex-end; gap: 6px; line-height: 1; }
  .wrx-lp .stat-num { font-family: var(--font-serif); font-weight: 400; line-height: 1.05; color: var(--brand-primary); }
  .wrx-lp .stat-unit { font-family: var(--font-body); font-weight: 500; color: var(--brand-primary); letter-spacing: -0.01em; white-space: nowrap; }

  .wrx-lp .faq-item { border-bottom: 1px solid rgba(0,0,0,0.08); }
  .wrx-lp .faq-q {
    width: 100%; background: none; border: none; cursor: pointer; padding: 16px 0;
    display: flex; align-items: center; justify-content: space-between; gap: 12px; text-align: left;
  }
  .wrx-lp .faq-q > span:first-child {
    font-family: var(--font-body); font-weight: 500; font-size: 16px; color: var(--text-heading);
    letter-spacing: -0.01em; line-height: 1.25;
  }
  .wrx-lp .faq-toggle {
    flex-shrink: 0; width: 22px; height: 22px; border-radius: var(--radius-pill);
    background: var(--color-bg); box-shadow: inset 0 0 0 1px var(--wrx-line);
    display: inline-flex; align-items: center; justify-content: center;
    transition: background 120ms var(--ease-standard);
  }
  .wrx-lp .faq-toggle svg path { transform-origin: center; transition: transform 200ms var(--ease-standard); }
  .wrx-lp .faq-item[data-open="true"] .faq-toggle { background: var(--brand-primary); box-shadow: none; }
  .wrx-lp .faq-item[data-open="true"] .faq-toggle svg path { transform: rotate(45deg); stroke: #fff; }
  .wrx-lp .faq-a { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 200ms var(--ease-standard); }
  .wrx-lp .faq-item[data-open="true"] .faq-a { grid-template-rows: 1fr; }
  .wrx-lp .faq-a > div { overflow: hidden; }
  .wrx-lp .faq-a p {
    margin: 0; padding-bottom: 16px; font-family: var(--font-body); font-size: 14px;
    line-height: 1.4; letter-spacing: -0.01em; color: var(--text-body);
  }

  /* ════════ MOBILE layout (< 900px) — unchanged approved design ════════ */
  .wrx-mobile { display: flex; justify-content: center; background: #dfe4ea; }
  .wrx-mobile .device { width: 420px; max-width: 100%; min-height: 100vh; background: var(--color-bg); position: relative; box-shadow: 0 0 80px rgba(16,24,40,.14); }
  .wrx-mobile .scroll { padding-bottom: 92px; }
  .wrx-mobile section { padding: 0 18px; }
  .wrx-mobile .eyebrow { font-size: 13px; color: var(--brand-primary); letter-spacing: -0.01em; font-weight: 500; }
  .wrx-mobile h1, .wrx-mobile h2 { margin: 0; font-family: var(--font-heading); color: var(--text-heading); letter-spacing: -0.02em; }
  .wrx-mobile h1 { font-size: 34px; line-height: 1.04; font-weight: 600; }
  .wrx-mobile h2 { font-size: 26px; line-height: 1.08; font-weight: 600; }
  .wrx-mobile .lede { margin: 0; font-size: 15px; line-height: 1.45; color: var(--text-body); }
  .wrx-mobile .divider { height: 9px; background: var(--color-bg); }
  .wrx-mobile .stat-num { font-size: 44px; }
  .wrx-mobile .stat-unit { font-size: 14px; padding-bottom: 4px; }
  @media (max-width: 440px) { .wrx-mobile .device { box-shadow: none; } }

  .wrx-lp-sticky {
    position: fixed; bottom: 0; left: 50%;
    transform: translateX(-50%) translateY(130%); opacity: 0; pointer-events: none;
    transition: transform .3s cubic-bezier(.4,0,.2,1), opacity .3s cubic-bezier(.4,0,.2,1);
    width: 420px; max-width: 100%; z-index: 40; padding: 12px 18px 16px;
    background: linear-gradient(180deg, rgba(249,249,249,0), #f9f9f9 40%);
  }
  .wrx-lp-sticky.show { transform: translateX(-50%) translateY(0); opacity: 1; pointer-events: auto; }

  /* ════════ DESKTOP layout (>= 900px) ════════ */
  .wrx-desktop { display: none; background: var(--color-bg); }
  @media (min-width: 900px) {
    .wrx-mobile { display: none; }
    .wrx-desktop { display: block; }
    .wrx-lp-sticky { display: none !important; }
  }
  .wrx-desktop .wrap { max-width: 1180px; margin: 0 auto; padding: 0 40px; }
  .wrx-desktop h1, .wrx-desktop h2, .wrx-desktop h3 { margin: 0; font-family: var(--font-heading); color: var(--text-heading); letter-spacing: -0.022em; }
  .wrx-desktop h1 { font-size: 62px; line-height: 1.02; font-weight: 600; }
  .wrx-desktop h2 { font-size: 40px; line-height: 1.06; font-weight: 600; }
  .wrx-desktop h3 { font-size: 20px; line-height: 1.15; font-weight: 600; }
  .wrx-desktop .eyebrow { font-size: 14px; color: var(--brand-primary); font-weight: 500; letter-spacing: -0.01em; }
  .wrx-desktop .lede { font-size: 19px; line-height: 1.5; color: var(--text-body); margin: 0; }
  .wrx-desktop .hero { display: grid; grid-template-columns: 1.08fr 0.92fr; gap: 56px; align-items: center; }
  .wrx-desktop .cols-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .wrx-desktop .proof-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px; align-items: stretch; }
  .wrx-desktop .cols-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; }
  .wrx-desktop .why { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .wrx-desktop .foot { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.1fr; gap: 36px; }
  .wrx-desktop .nav-links { display: flex; align-items: center; gap: 26px; }
  .wrx-desktop .nav-links a { white-space: nowrap; }
  .wrx-desktop .stat-num { font-size: 58px; }
  .wrx-desktop .stat-unit { font-size: 16px; padding-bottom: 5px; }
  @media (max-width: 1000px) {
    .wrx-desktop h1 { font-size: 48px; }
    .wrx-desktop h2 { font-size: 32px; }
    .wrx-desktop .wrap { padding: 0 28px; }
    .wrx-desktop .nav-links { display: none; }
  }
  @media (max-width: 980px) {
    .wrx-desktop .cols-4 { grid-template-columns: repeat(2, 1fr); }
    .wrx-desktop .foot { grid-template-columns: 1fr 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .wrx-lp .cta-shine::after { animation: none; } }
{%- endstyle -%}

