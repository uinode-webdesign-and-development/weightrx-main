  <a href="{{ cta_url }}" class="btn cta-shine"><span>{{ cta_label }}</span>{{ cta_arrow }}</a>
</div>

<script>
(function () {
  /* ---- Urgency countdown (15 min, persisted; updates both layouts) ---- */
  var KEY = "wrx_lean_deadline";
  var clocks = document.querySelectorAll('[data-wrx-clock]');
  if (clocks.length) {
    var dl = +localStorage.getItem(KEY);
    if (!dl || dl < Date.now()) { dl = Date.now() + 15 * 60 * 1000; localStorage.setItem(KEY, dl); }
    var tick = function () {
      var left = Math.max(0, Math.round((dl - Date.now()) / 1000));
      var mm = String(Math.floor(left / 60)).padStart(2, "0");
      var ss = String(left % 60).padStart(2, "0");
      clocks.forEach(function (c) { c.textContent = mm + ":" + ss; });
    };
    tick(); setInterval(tick, 1000);
  }

  /* ---- FAQ accordions (single-open, each instance independent) ---- */
  document.querySelectorAll('[data-wrx-faq]').forEach(function (faq) {
    var items = faq.querySelectorAll('.faq-item');
    items.forEach(function (item) {
      var btn = item.querySelector('.faq-q');
      btn.addEventListener('click', function () {
        var isOpen = item.getAttribute('data-open') === 'true';
        items.forEach(function (it) {
          it.setAttribute('data-open', 'false');
          it.querySelector('.faq-q').setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) { item.setAttribute('data-open', 'true'); btn.setAttribute('aria-expanded', 'true'); }
      });
    });
  });

  /* ---- Mobile sticky CTA: show once the hero CTA scrolls out of view ---- */
  var sticky = document.querySelector('[data-wrx-sticky]');
  var heroCta = document.getElementById('heroCta');
  if (sticky && heroCta) {
    var onScroll = function () {
      sticky.classList.toggle('show', heroCta.getBoundingClientRect().bottom < 8);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  /* ---- LegitScript: reveal the real seal once it loads (off-domain stays as badge) ---- */
  document.querySelectorAll('[data-legit]').forEach(function (seal) {
    var img = seal.querySelector('[data-legit-img]');
    var badge = seal.querySelector('[data-legit-badge]');
    if (!img) return;
    var reveal = function () {
      img.style.display = 'block';
      if (badge) badge.style.display = 'none';
      seal.style.background = '#fff';
      seal.style.border = 'none';
      seal.style.padding = '8px 10px';
      seal.style.lineHeight = '0';
    };
    img.addEventListener('load', reveal);
    if (img.complete && img.naturalWidth > 0) reveal();
  });
})();
</script>

