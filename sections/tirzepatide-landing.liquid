{%- comment -%}
  WeightRx — Tirzepatide Landing Page (responsive)
  Faithful Liquid port of ui_kits/tirzepatide-lean/responsive.html from the
  WeightRx Design System. Self-contained: ships its own tokens, fonts and CSS
  so it renders identically inside any Shopify theme. Drop it on a page via the
  theme editor (template page.tirzepatide.json) or add it to any template.

  All CTA pills link to the experiment funnel URL (editable in the schema).
{%- endcomment -%}

{%- assign cta_url = section.settings.cta_url | default: 'https://experiments.weightrx.com/e2dd8c36-ac07-44dc-9779-c73550a70b6e' -%}
{%- assign cta_label = section.settings.cta_label | default: 'Start My Assessment — $83/mo' -%}
{%- assign fb_pixel_id = section.settings.facebook_pixel_id | default: '1276955633791842' -%}

{%- comment -%} ── Tracking: per-visit event id, WeightRx tracker, Meta pixel ── {%- endcomment -%}
<script>
  window.WEIGHTRX_EVENT_ID =
  (window.crypto && crypto.randomUUID)
    ? crypto.randomUUID()
    : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
        var r = (Math.random() * 16) | 0, v = c === 'x' ? r : (r & 0x3) | 0x8;
        return v.toString(16);
      });
</script>
<script async src="https://admin.weightrx.com/tracker.min.js"></script>
<script>
  !function (f, b, e, v, n, t, s) {
      if (f.fbq) return; n = f.fbq = function () {
      n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments)
      };
      if (!f._fbq) f._fbq = n; n.push = n; n.loaded = !0; n.version = '2.0';
      n.queue = []; t = b.createElement(e); t.async = !0;
      t.src = v; s = b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t, s)
  }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', '{{ fb_pixel_id }}');
  fbq('track', 'ViewContent', {}, { eventID: window.WEIGHTRX_EVENT_ID });
</script>
<noscript>
  <img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id={{ fb_pixel_id }}&ev=ViewContent&noscript=1" />
</noscript>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&family=Instrument+Serif:ital@0;1&family=Geist:wght@400;500;600&family=Road+Rage&display=swap">

{%- style -%}
  @font-face {
    font-family: "SF Pro Display"; font-weight: 400; font-style: normal; font-display: swap;
    src: url("{{ 'SFProDisplay-Regular.otf' | asset_url }}") format("opentype");
  }
  @font-face {
    font-family: "SF Pro Display"; font-weight: 500; font-style: normal; font-display: swap;
    src: url("{{ 'SFProDisplay-Medium.otf' | asset_url }}") format("opentype");
  }
  @font-face {
    font-family: "SF Pro Display"; font-weight: 700; font-style: normal; font-display: swap;
    src: url("{{ 'SFProDisplay-Bold.otf' | asset_url }}") format("opentype");
  }

  .wrx-lp {
    /* ---- design-system tokens (scoped so the page is theme-independent) ---- */
    --color-bg: #f9f9f9;
    --wrx-blue-50: #eaf2ff;
    --brand-primary: #006bff;
    --brand-primary-ink: #ffffff;
    --wrx-navy-900: #162036;
    --wrx-navy-950: #031f46;
    --wrx-ink: #2f2f2f;
    --wrx-black: #000000;
    --wrx-line: rgba(0,0,0,0.15);
    --text-heading: #2f2f2f;
    --text-body: rgba(0,0,0,0.80);
    --text-subtle: rgba(0,0,0,0.60);
    --success: #6fcc58;
    --success-star: #00b67a;
    --font-body: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --font-heading: "SF Pro Display", -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif;
    --font-serif: "Instrument Serif", ui-serif, Georgia, "Times New Roman", serif;
    --font-script: "Road Rage", "Brush Script MT", cursive;
    --font-label: "Geist", "Inter", -apple-system, sans-serif;
    --radius-pill: 999px;
    --shadow-card: 0 1px 2px rgba(16,24,40,0.04), 0 1px 3px rgba(16,24,40,0.06);
    --shadow-cta: 0 6px 16px rgba(0,107,255,0.28);
    --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);

    background: var(--color-bg);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    color: var(--text-body);
    color-scheme: light;
  }
  .wrx-lp *, .wrx-lp *::before, .wrx-lp *::after { box-sizing: border-box; }
  .wrx-lp .wrap { max-width: 1180px; margin: 0 auto; padding: 0 40px; }
  .wrx-lp h1, .wrx-lp h2, .wrx-lp h3 { margin: 0; font-family: var(--font-heading); color: var(--text-heading); letter-spacing: -0.022em; }
  .wrx-lp h1 { font-size: 62px; line-height: 1.02; font-weight: 600; }
  .wrx-lp h2 { font-size: 40px; line-height: 1.06; font-weight: 600; }
  .wrx-lp h3 { font-size: 20px; line-height: 1.15; font-weight: 600; }
  .wrx-lp .eyebrow { font-size: 14px; color: var(--brand-primary); font-weight: 500; letter-spacing: -0.01em; }
  .wrx-lp .lede { font-size: 19px; line-height: 1.5; color: var(--text-body); margin: 0; }
  .wrx-lp a { color: inherit; }

  /* ---- CTA pill (Button: primary / lg) ---- */
  .wrx-lp .btn {
    display: inline-flex; width: 100%; box-sizing: border-box; height: 55px; padding: 0 16px;
    gap: 8px; align-items: center; justify-content: center; border: none; border-radius: var(--radius-pill);
    background: var(--brand-primary); color: var(--brand-primary-ink); box-shadow: var(--shadow-cta);
    font-family: var(--font-body); font-weight: 500; font-size: 16px; letter-spacing: -0.01em;
    line-height: 1; cursor: pointer; text-decoration: none;
    transition: transform 120ms var(--ease-standard), filter 120ms var(--ease-standard);
  }
  .wrx-lp .btn:active { transform: scale(0.98); }
  .wrx-lp .btn > span { white-space: nowrap; }
  .wrx-lp .btn--sm { height: 38px; padding: 0 12px; font-size: 14px; width: auto; }
  .wrx-lp .btn--sm svg { width: 15px; height: 15px; }

  /* CTA shine sweep */
  .wrx-lp .cta-shine { position: relative !important; overflow: hidden !important; }
  .wrx-lp .cta-shine::after {
    content: ""; position: absolute; top: 0; bottom: 0; left: -150%; width: 55%;
    background: linear-gradient(100deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.5) 50%, rgba(255,255,255,0) 100%);
    transform: skewX(-18deg); pointer-events: none;
    animation: wrxCtaSweep 4s cubic-bezier(.4,0,.2,1) infinite;
  }
  @keyframes wrxCtaSweep { 0% { left: -150%; } 60% { left: 175%; } 100% { left: 175%; } }

  /* ---- TrustChip ---- */
  .wrx-lp .chip {
    display: inline-flex; align-items: center; gap: 6px; padding: 6px 8px; border-radius: var(--radius-pill);
    background: var(--color-bg); box-shadow: inset 0 0 0 1px var(--wrx-line);
    font-family: var(--font-body); font-size: 12px; letter-spacing: -0.01em; color: var(--wrx-black);
    line-height: 1; white-space: nowrap;
  }

  /* ---- StarRating tiles ---- */
  .wrx-lp .stars { display: inline-flex; gap: 1.5px; }
  .wrx-lp .star { flex-shrink: 0; background: var(--success-star); display: inline-flex; align-items: center; justify-content: center; }

  /* ---- Badge (brand) ---- */
  .wrx-lp .badge-brand {
    display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: var(--radius-pill);
    background: var(--brand-primary); color: #fff; font-family: var(--font-body); font-weight: 500;
    font-size: 12px; letter-spacing: -0.01em; line-height: 1; white-space: nowrap;
  }

  /* ---- Stat (Instrument-Serif figure) ---- */
  .wrx-lp .stat { display: inline-flex; align-items: flex-end; gap: 6px; line-height: 1; }
  .wrx-lp .stat-num { font-family: var(--font-serif); font-weight: 400; font-size: 58px; line-height: 1.05; color: var(--brand-primary); }
  .wrx-lp .stat-unit { font-family: var(--font-body); font-weight: 500; font-size: 16px; color: var(--brand-primary); letter-spacing: -0.01em; padding-bottom: 5px; white-space: nowrap; }

  /* ---- FAQ accordion ---- */
  .wrx-lp .faq-item { border-bottom: 1px solid rgba(0,0,0,0.08); }
  .wrx-lp .faq-q {
    width: 100%; background: none; border: none; cursor: pointer; padding: 16px 0;
    display: flex; align-items: center; justify-content: space-between; gap: 12px; text-align: left;
  }
  .wrx-lp .faq-q > span:first-child {
    font-family: var(--font-body); font-weight: 500; font-size: 16px; color: var(--text-heading);
    letter-spacing: -0.01em; line-height: 1.25;
  }
  .wrx-lp .faq-toggle {
    flex-shrink: 0; width: 22px; height: 22px; border-radius: var(--radius-pill);
    background: var(--color-bg); box-shadow: inset 0 0 0 1px var(--wrx-line);
    display: inline-flex; align-items: center; justify-content: center;
    transition: background 120ms var(--ease-standard);
  }
  .wrx-lp .faq-toggle svg path { transform-origin: center; transition: transform 200ms var(--ease-standard); }
  .wrx-lp .faq-item[data-open="true"] .faq-toggle { background: var(--brand-primary); box-shadow: none; }
  .wrx-lp .faq-item[data-open="true"] .faq-toggle svg path { transform: rotate(45deg); stroke: #fff; }
  .wrx-lp .faq-a { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 200ms var(--ease-standard); }
  .wrx-lp .faq-item[data-open="true"] .faq-a { grid-template-rows: 1fr; }
  .wrx-lp .faq-a > div { overflow: hidden; }
  .wrx-lp .faq-a p {
    margin: 0; padding-bottom: 16px; font-family: var(--font-body); font-size: 14px;
    line-height: 1.4; letter-spacing: -0.01em; color: var(--text-body);
  }

  /* ---- responsive layout (verbatim from the source page) ---- */
  .wrx-lp .hero { display: grid; grid-template-columns: 1.08fr 0.92fr; gap: 56px; align-items: center; }
  .wrx-lp .cols-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .wrx-lp .proof-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px; align-items: stretch; }
  .wrx-lp .cols-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; }
  .wrx-lp .why { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .wrx-lp .foot { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.1fr; gap: 36px; }
  .wrx-lp .nav-links { display: flex; align-items: center; gap: 26px; }
  .wrx-lp .nav-links a { white-space: nowrap; }
  .wrx-lp .mobile-cta { display: none; }

  @media (max-width: 1000px) {
    .wrx-lp h1 { font-size: 48px; }
    .wrx-lp h2 { font-size: 32px; }
    .wrx-lp .wrap { padding: 0 28px; }
    .wrx-lp .nav-links { display: none; }
  }
  @media (max-width: 980px) {
    .wrx-lp .cols-4 { grid-template-columns: repeat(2, 1fr); }
    .wrx-lp .foot { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 720px) {
    .wrx-lp .hero, .wrx-lp .why { grid-template-columns: 1fr; }
    .wrx-lp .cols-4, .wrx-lp .proof-grid, .wrx-lp .cols-3 { grid-template-columns: 1fr; }
    .wrx-lp h1 { font-size: 40px; }
    .wrx-lp h2 { font-size: 28px; }
    .wrx-lp .lede { font-size: 17px; }
    .wrx-lp .mobile-cta { display: block; }
    .wrx-lp { padding-bottom: 86px; }
  }
  @media (max-width: 520px) {
    .wrx-lp .foot { grid-template-columns: 1fr; }
    .wrx-lp .wrap { padding: 0 20px; }
  }
  @media (prefers-reduced-motion: reduce) { .wrx-lp .cta-shine::after { animation: none; } }
{%- endstyle -%}

